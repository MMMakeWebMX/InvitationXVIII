---
import { Analytics } from '@vercel/analytics/react';
import Header from "../components/Header.astro";
// @ts-ignore: Allow side-effect import of global CSS without type declarations
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Te invito a celebrar mis 18 años - 31 de octubre del 2026 - Salon 'México lindo' (Soldead de graciano Sánchez, S.L.P.) - Mayte" />
		<link rel="icon" type="image/svg+xml" href="../MakeWeb_MM.svg" />
		<link href="https://fonts.cdnfonts.com/css/tempting" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>Mis 18 Mayte</title>
	</head>
	
	<body class="bg-fixed bg-[url('../background.webp')] bg-center bg-no-repeat text-[#1E2D42]">
		<Header />
		<slot />
		<Analytics />
	</body>

</html>


<style is:global>
    html {
		  	font-family: 'font';
  			src: url('fonts/font.ttf') format('truetype');
  			font-optical-sizing: auto;
			font-weight: normal;
  			font-style: normal;
	}
</style>

<script type="text/javascript">
    const audio = document.getElementById("myAudio");
    const playPauseBtn = document.getElementById("playPauseBtn");

    playPauseBtn.addEventListener("click", function() {
        if (audio.paused) {
            audio.play();
            playPauseBtn.textContent = "🔊";
        } else {
            audio.pause();
            playPauseBtn.textContent = "🔇";
        }
    });
</script>