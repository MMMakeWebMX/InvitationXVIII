---
import Loading from '../components/Loading.jsx';
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Ubication from '../components/Ubication.astro';
import Makeweb from '../components/Makeweb.astro';
import Timer from '../components/Timer.jsx';
// Importante: el componente Loading debe ser cargado en el cliente
// Puedes controlar el loader con un pequeño estado en JS
---

<Layout>
	<Loading client:only="react">
		<section class="flex flex-col items-center justify-center h-screen w-screen">
			<Hero />
		</section>
		
		<section class="overflow-hidden flex flex-col items-center justify-center w-screen">
			<Ubication />
		</section>

		<section class="flex flex-col items-center justify-center md:h-auto w-screen">
			<Timer client:visible/>
		</section>

		<section class="items-center justify-center w-screen">
			<Makeweb />
		</section>
	</Loading>
</Layout>
